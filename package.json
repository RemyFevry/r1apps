{
  "name": "r1apps",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter './apps/*' build",
    "build:site": "node scripts/build-site.mjs",
    "host-book": "node scripts/host-book.mjs",
    "bookshelf": "tsx scripts/bookshelf.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "r1:compat": "node scripts/check-r1-compat.mjs",
    "r1:smoke": "playwright test",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm r1:compat && pnpm r1:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "happy-dom": "^20.11.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
